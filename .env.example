# Server
PORT=5000
NODE_ENV=production

# GPS TCP Server
GPS_PORT=8080

# Database
MONGODB_URI=mongodb+srv://YOUR_USER:YOUR_PASS@cluster.mongodb.net/busnest

# Auth
JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_EXPIRES_IN=7d

# API base (update after deploy)
API_BASE=https://YOUR_RAILWAY_APP.railway.app/api

# Optional: protect the JSON GPS telemetry endpoint.
# Leave blank for local Postman/terminal testing only.
TELEMETRY_API_KEY=
GPS_PORT=9091

ADMIN_EMAIL=admin@busnest.rw
ADMIN_PASSWORD=ChangeMe123!
ADMIN_NAME=BusNest Administrator
PARENT_TRIP_START_SMS=true
